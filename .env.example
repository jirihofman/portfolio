GH_TOKEN=
VC_TOKEN=
IS_TEMPLATE=true

# Optional: server-only OpenRouter management key enables /ai-usage
OPENROUTER_MANAGEMENT_KEY=

# Optional: shared GitHub concurrency/cooldowns across server instances.
# Both values are required together. Unconfigured deployments use local limits.
GITHUB_REDIS_REST_URL=
GITHUB_REDIS_REST_TOKEN=
